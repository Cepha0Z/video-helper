{
  "manifest_version": 3,
  "name": "Video Helper",
  "description": "Find video streams on enabled sites and save direct files or unencrypted HLS, DASH and supported YouTube video on demand.",
  "version": "0.3.0",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting", "storage", "webRequest", "downloads", "offscreen", "declarativeNetRequestWithHostAccess"],
  "host_permissions": [
    "https://100xdevs.com/*",
    "https://transcoded-video.b-cdn.net/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Video Helper", "default_popup": "popup.html" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" }
}
